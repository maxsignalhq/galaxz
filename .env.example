# Andromeda API key — set this to secure your deployment
GALAXZ_API_KEY=change-me-before-deploying

# LLM provider — all three vars are required.
# ANTHROPIC_MODEL uses litellm routing format: "<provider>/<model>"
# Examples: anthropic/claude-sonnet-4-6   openai/gpt-4o   ollama/llama3
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=your-api-key-here

# Redis / Aether message bus
# Use redis://aether:6379 when running inside Docker Compose.
# Use redis://localhost:6379 when running outside Docker (local dev).
REDIS_URL=redis://aether:6379

# Orion data refinery
ORION_REDIS_URL=redis://aether:6379
ORION_DB_PATH=orion/data/events.db
ORION_DATASET_PATH=orion/data/datasets

# Pulsar storage backend
# Default: SQLite (no configuration needed for single-instance deployments)
# For multi-instance / production: set to PostgreSQL connection string
# PULSAR_DB_URL=postgresql://user:password@host:5432/galaxz

# Rigel engineering agent
RIGEL_EXECUTION_CALIBRATION_ENABLED=true
RIGEL_EXECUTION_TIMEOUT_S=30
RIGEL_EXECUTION_IMAGE=galaxz:latest
