# Andromeda API key — set this to secure your deployment
GALAXZ_API_KEY=change-me-before-deploying

# LLM provider — all three vars are required.
# The configured provider is prepended by Galaxz, so this is the provider's
# model name (without an additional "anthropic/" prefix).
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=your-api-key-here

# Redis / Aether message bus
# Use redis://aether:6379 when running inside Docker Compose.
# Use redis://localhost:6379 when running outside Docker (local dev).
REDIS_URL=redis://aether:6379

# Orion data refinery
ORION_REDIS_URL=redis://aether:6379
ORION_DB_PATH=orion/data/events.db
ORION_DATASET_PATH=orion/data/datasets

# Durable worker queue
JOB_DB_PATH=/var/lib/galaxz/jobs.db
GALAXZ_ARTIFACT_STORAGE=inline
# For external payloads, choose local or s3.
GALAXZ_ARTIFACT_STORAGE_ROOT=/var/lib/galaxz/artifacts
GALAXZ_ARTIFACT_MAX_BYTES=52428800
# GALAXZ_ARTIFACT_S3_BUCKET=galaxz-artifacts
# GALAXZ_ARTIFACT_S3_PREFIX=production
# GALAXZ_ARTIFACT_S3_ENDPOINT=https://s3.example.internal
GOAL_DB_PATH=/var/lib/galaxz/goals.db
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=10
WORKER_POLL_SECONDS=0.25
GOAL_CONCURRENCY=4
GLOBAL_JOB_CONCURRENCY=32

# GitHub pull requests, check runs, and signed webhooks
# GALAXZ_GITHUB_TOKEN=github-token-with-repository-permissions
# GALAXZ_GITHUB_API_URL=https://api.github.com
# GALAXZ_GITHUB_WEBHOOK_SECRET=webhook-secret
# GITHUB_WEBHOOK_DB_PATH=data/github-webhooks.db

# Pulsar storage backend
# Default: SQLite (no configuration needed for single-instance deployments)
# For multi-instance / production: set to PostgreSQL connection string
# PULSAR_DB_URL=postgresql://user:password@host:5432/galaxz

# Rigel engineering agent
RIGEL_EXECUTION_CALIBRATION_ENABLED=true
RIGEL_EXECUTION_TIMEOUT_S=30
RIGEL_EXECUTION_IMAGE=galaxz:latest
